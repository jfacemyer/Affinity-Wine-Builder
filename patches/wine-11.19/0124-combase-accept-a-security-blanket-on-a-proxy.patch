combase: Accept a security blanket on a proxy.

Calls are not authenticated, so there is nothing to change; Windows
accepts the blanket. .NET's System.Management sets one on every WMI
proxy and fails the query when that fails.
---
 dlls/combase/marshal.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/dlls/combase/marshal.c b/dlls/combase/marshal.c
index 6e3d35c..b2c74ee 100644
--- a/dlls/combase/marshal.c
+++ b/dlls/combase/marshal.c
@@ -1394,7 +1394,10 @@ static HRESULT WINAPI ProxyCliSec_SetBlanket(IClientSecurity *iface,
     FIXME("%p, %ld, %ld, %s, %ld, %ld, %p, %#lx: stub\n", pProxy, AuthnSvc, AuthzSvc,
           pServerPrincName == COLE_DEFAULT_PRINCIPAL ? "<default principal>" : debugstr_w(pServerPrincName),
           AuthnLevel, ImpLevel, pAuthInfo, Capabilities);
-    return E_NOTIMPL;
+    /* Calls are not authenticated, so there is nothing to change. Windows
+     * accepts a blanket on a proxy, and .NET's System.Management sets one on
+     * each WMI proxy and fails the query when that fails. */
+    return S_OK;
 }
 
 static HRESULT WINAPI ProxyCliSec_CopyProxy(IClientSecurity *iface,
