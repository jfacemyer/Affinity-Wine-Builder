+void * WINAPI clSVMAlloc( cl_context context, cl_bitfield flags, size_t size, unsigned int alignment )
+{
+    void *__retval;
+    struct clSVMAlloc_params params = { &__retval, context, flags, size, alignment };
+    TRACE( "(%p, %s, %Iu, %u)\n", context, wine_dbgstr_longlong(flags), size, alignment );
+    OPENCL_CALL( clSVMAlloc, &params );
+    return __retval;
+}
+
+void WINAPI clSVMFree( cl_context context, void *svm_pointer )
+{
+    struct clSVMFree_params params = { context, svm_pointer };
+    TRACE( "(%p, %p)\n", context, svm_pointer );
+    OPENCL_CALL( clSVMFree, &params );
+}
+
