From: Affinity-Wine-Builder
Date: 2026-10-12
Subject: wined3d: Re-target stale full presents at the current client area
 on fast resize

The command stream queues present src/dst rects on the application thread
but executes them later; a fast resize (drag, maximize) can grow the
window in between. Presenting the stale rects then leaves the expanded
area undefined (black): the Vulkan blit clips dst to the old swapchain
size, the GDI blit only refreshes the old region -- and a stale full
present even takes the GDI path, because dst no longer matches the
current client rect. With throttled presents (Affinity canvas only
presents on changes) the black half sticks until a scroll/zoom forces
a repaint.

Fix it in swapchain_vk_present(), before the partial/GDI split:

- If the live client area differs from the Vulkan swapchain size,
  recreate the swapchain upfront so this very present can fill the new
  size.
- If a 1:1 origin-based full present no longer matches the live client
  area, expand dst to the full client (and src to the live backbuffer if
  ResizeBuffers already ran). A stale smaller backbuffer scales up with
  LINEAR filtering: blurry for one frame, never black. This is restricted
  to swap effects whose backbuffer holds the whole frame (COPY) or that
  mandate full presents (flip); DISCARD backbuffers may hold garbage
  outside a dirty rect and are left alone.
- After presenting, retry the blit once on SUBOPTIMAL as well as on
  OUT_OF_DATE (previously only OUT_OF_DATE was retried, so a resize
  frame was dropped). Only a negative retry result is logged: a second
  SUBOPTIMAL still presented a frame (the window moved again
  mid-recreate) and is picked up by the next present.

Repro: open a large Affinity document, drag-resize the main window fast.
Before: part of the canvas sticks black until scroll. After: every
present covers the full client area.

--- a/dlls/wined3d/swapchain.c
+++ b/dlls/wined3d/swapchain.c
@@ -1271,6 +1271,72 @@
 
     context_vk = wined3d_context_vk(context_acquire(swapchain->device, back_buffer, 0));
 
+    /* Fast resize: the command stream queues src/dst rects on the app
+     * thread but executes them later; a fast resize (or maximize) can grow
+     * the window in between. Presenting the stale rects then leaves the
+     * expanded area undefined (black): the Vulkan blit clips dst to the old
+     * swapchain size, the GDI blit only refreshes the old region, and with
+     * throttled presents (Affinity's canvas only presents on changes) it
+     * sticks until the next scroll/zoom forces a repaint. */
+    if (swapchain->state.desc.windowed && swapchain->win_handle
+            && swapchain->win_handle != GetDesktopWindow()
+            && swapchain_vk->vk_swapchain)
+    {
+        RECT client_rect, src_tmp, dst_tmp;
+
+        if (GetClientRect(swapchain->win_handle, &client_rect)
+                && client_rect.right > 0 && client_rect.bottom > 0)
+        {
+            enum wined3d_swap_effect swap_effect = swapchain->state.desc.swap_effect;
+            unsigned int bb_width = back_buffer->resource.width;
+            unsigned int bb_height = back_buffer->resource.height;
+
+            if ((unsigned int)client_rect.right != swapchain_vk->width
+                    || (unsigned int)client_rect.bottom != swapchain_vk->height)
+            {
+                TRACE("Recreating Vulkan swapchain %p for resize %ux%u -> %ldx%ld before present.\n",
+                        swapchain_vk, swapchain_vk->width, swapchain_vk->height,
+                        client_rect.right, client_rect.bottom);
+                if (FAILED(hr = wined3d_swapchain_vk_recreate(swapchain_vk)))
+                    ERR("Failed to recreate swapchain for resize, hr %#lx.\n", hr);
+            }
+
+            /* A 1:1 full-buffer present queued before the resize has src ==
+             * dst == old size from the origin. Re-target it at the current
+             * sizes instead of leaving part of the window undefined. Only
+             * for effects whose backbuffer holds the whole frame (COPY) or
+             * that mandate full presents (flip): DISCARD backbuffers may
+             * hold garbage outside a dirty rect, which must not be smeared
+             * fullscreen. */
+            if ((swap_effect == WINED3D_SWAP_EFFECT_COPY
+                    || swap_effect == WINED3D_SWAP_EFFECT_COPY_VSYNC
+                    || swap_effect == WINED3D_SWAP_EFFECT_FLIP_SEQUENTIAL
+                    || swap_effect == WINED3D_SWAP_EFFECT_FLIP_DISCARD)
+                    && src_rect->left == 0 && src_rect->top == 0
+                    && dst_rect->left == 0 && dst_rect->top == 0
+                    && src_rect->right == dst_rect->right
+                    && src_rect->bottom == dst_rect->bottom
+                    && (dst_rect->right != client_rect.right
+                    || dst_rect->bottom != client_rect.bottom))
+            {
+                TRACE("Expanding stale full present %s to client %s (backbuffer %ux%u).\n",
+                        wine_dbgstr_rect(dst_rect), wine_dbgstr_rect(&client_rect),
+                        bb_width, bb_height);
+                /* ResizeBuffers may have run after the present was queued:
+                 * the live backbuffer is then already the new size while
+                 * src still describes the old one. */
+                if ((unsigned int)src_rect->right != bb_width
+                        || (unsigned int)src_rect->bottom != bb_height)
+                {
+                    SetRect(&src_tmp, 0, 0, bb_width, bb_height);
+                    src_rect = &src_tmp;
+                }
+                SetRect(&dst_tmp, 0, 0, client_rect.right, client_rect.bottom);
+                dst_rect = &dst_tmp;
+            }
+        }
+    }
+
     if (!swapchain_vk->vk_swapchain || swapchain_present_is_partial_copy(swapchain, dst_rect))
     {
         swapchain_blit_gdi(swapchain, &context_vk->c, src_rect, dst_rect);
@@ -1285,9 +1351,20 @@
             {
                 if (FAILED(hr = wined3d_swapchain_vk_recreate(swapchain_vk)))
                     ERR("Failed to recreate swapchain, hr %#lx.\n", hr);
-                else if (vr == VK_ERROR_OUT_OF_DATE_KHR && (vr = wined3d_swapchain_vk_blit(
-                        swapchain_vk, context_vk, src_rect, dst_rect, swap_interval)))
-                    ERR("Failed to blit image, vr %s.\n", wined3d_debug_vkresult(vr));
+                else
+                {
+                    /* Re-present the same frame on the fresh swapchain.
+                     * Previously only OUT_OF_DATE was retried; a SUBOPTIMAL
+                     * resize frame was dropped and -- with throttled
+                     * presents -- stuck black until the next repaint. A
+                     * second SUBOPTIMAL just means the window moved again
+                     * mid-recreate: the frame was still presented, so only
+                     * log real (negative) failures. */
+                    vr = wined3d_swapchain_vk_blit(swapchain_vk, context_vk,
+                            src_rect, dst_rect, swap_interval);
+                    if (vr < 0)
+                        ERR("Failed to blit image, vr %s.\n", wined3d_debug_vkresult(vr));
+                }
             }
             else
             {
