@@ -937,9 +1059,39 @@ cl_int WINAPI clSetKernelArg( cl_kernel
 
 cl_int WINAPI clSetMemObjectDestructorCallback( cl_mem memobj, void (WINAPI* pfn_notify)(cl_mem memobj, void* user_data), void* user_data )
 {
-    struct clSetMemObjectDestructorCallback_params params = { memobj, pfn_notify, user_data };
+    struct memobj_dtor *d;
     TRACE( "(%p, %p, %p)\n", memobj, pfn_notify, user_data );
-    return OPENCL_CALL( clSetMemObjectDestructorCallback, &params );
+    /* The host wrapper is a no-op that cannot invoke PE code; track the
+     * callback here instead (see release_memobj). */
+    d = HeapAlloc( GetProcessHeap(), 0, sizeof(*d) );
+    if (!d) return CL_OUT_OF_HOST_MEMORY;
+    d->pfn_notify = pfn_notify;
+    d->user_data = user_data;
+    AcquireSRWLockExclusive( &memobj_lock );
+    {
+        struct memobj_track *node = find_memobj_locked( memobj );
+        if (!node)
+        {
+            node = HeapAlloc( GetProcessHeap(), 0, sizeof(*node) );
+            if (node)
+            {
+                node->memobj = memobj;
+                node->refs = 0;
+                node->tracked = FALSE;
+                node->dtors = NULL;
+                node->next = memobj_list;
+                memobj_list = node;
+            }
+        }
+        if (node)
+        {
+            d->next = node->dtors;
+            node->dtors = d;
+        }
+        else HeapFree( GetProcessHeap(), 0, d );
+    }
+    ReleaseSRWLockExclusive( &memobj_lock );
+    return CL_SUCCESS;
 }
 
 cl_int WINAPI clSetUserEventStatus( cl_event event, cl_int execution_status )
